Screen {
    layout: vertical;
}

#setup-wizard {
    width: 100%;
    height: 100%;
}

#setup-shell {
    width: 100%;
    height: 1fr;
}

#setup-navigation {
    width: 22;
    border-right: solid $primary;
    padding: 1;
}

#setup-form {
    width: 1fr;
    padding: 1 2;
}

#setup-summary {
    width: 28;
    border-left: solid $primary;
    padding: 1;
}

.setup-step {
    width: 100%;
    height: auto;
}

.setup-step Input,
.setup-step Select,
.setup-step Button {
    width: 100%;
    margin-bottom: 1;
}

#repository-list {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

.setup-nav-button {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    content-align: left middle;
    text-align: left;
}

#setup-actions {
    width: 100%;
    height: 3;
}

#setup-actions Button {
    width: 1fr;
}

#setup-wizard.two #setup-summary {
    display: none;
}

#setup-wizard.two #setup-navigation {
    width: 20;
}

#setup-wizard.one #setup-navigation,
#setup-wizard.one #setup-summary {
    display: none;
}

#dashboard {
    width: 100%;
    height: 1fr;
}

#action-bar {
    height: 3;
    width: 100%;
    padding: 0 5 0 1;
}

#action-bar Button {
    width: auto;
    min-width: 18;
    margin-right: 1;
}

#analysis-decision-bar {
    height: 3;
}

#analysis-decision-bar Button {
    width: 1fr;
}

#detail-action-notice {
    height: 1;
}

#notice,
#modal-notice {
    height: 1;
}

ApprovalModal,
MergeReadinessModal,
RevisionModal,
CancelModal,
PublicationResumeModal {
    layout: vertical;
}

WorkspaceDeleteConfirmation {
    layout: vertical;
    padding: 2 4;
}

ApprovalModal > VerticalScroll,
MergeReadinessModal > VerticalScroll,
RevisionModal > VerticalScroll,
CancelModal > VerticalScroll,
PublicationResumeModal > VerticalScroll {
    height: 1fr;
}

ApprovalModal,
MergeReadinessModal {
    align: center middle;
    background: $background 70%;
}

#merge-readiness-evidence {
    height: 8;
    border: round $primary-muted;
    margin-bottom: 1;
}

#approval-dialog {
    width: 94%;
    max-width: 116;
    height: 94%;
    background: $surface;
    border: round $primary;
    padding: 0 1;
}

#approval-title {
    height: 1;
    text-style: bold;
    color: $text;
}

#approval-subtitle {
    height: 1;
    color: $text-muted;
}

#approval-body {
    height: 1fr;
}

.approval-card {
    height: auto;
    border: round $primary-muted;
    padding: 0 1;
    margin-bottom: 1;
}

.approval-card Static {
    height: auto;
}

.approval-heading {
    color: $accent;
    text-style: bold;
}

.approval-warning {
    border: round $warning;
}

.approval-warning .approval-heading {
    color: $warning;
}

.approval-error {
    color: $error;
    height: auto;
}

#approval-footer {
    height: auto;
    border-top: solid $primary-muted;
}

#approval-footer Select {
    margin: 0;
}

#approval-buttons {
    height: 3;
    align-horizontal: right;
}

#approval-buttons Button {
    width: auto;
    min-width: 10;
    margin-left: 1;
}

#ones-settings-form {
    padding: 1 2;
    max-width: 110;
}

#ones-settings-form > Label {
    margin-top: 1;
}

#ones-settings-form Input {
    width: 100%;
}

#inline-ones-actions {
    height: 3;
    margin-top: 1;
}

#inline-ones-actions Button {
    width: auto;
    margin-right: 1;
}

#inline-ones-notice {
    height: auto;
    margin-top: 1;
}

WorkspaceDeleteConfirmation > VerticalScroll {
    height: auto;
    max-height: 18;
    border: solid $error;
    padding: 1 2;
}

#navigation {
    width: 22;
    padding: 1;
    border-right: solid $primary;
}

#navigation Button {
    width: 100%;
    margin-bottom: 1;
}

#workspace {
    width: 1fr;
    height: 100%;
}

#task-detail-column {
    width: 1fr;
    height: 100%;
}

#task-detail-column > RunDetailPane {
    height: 1fr;
}

#workspace-home {
    width: 1fr;
    height: 100%;
}

#workspace-list-pane {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#workspace-list {
    height: 1fr;
    margin-top: 1;
}
#workspace-home-description, #workspace-list-summary, #workspace-empty {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}
#workspace-list-summary { margin-top: 1; margin-bottom: 0; }
#workspace-list .workspace-home-card {
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 0 1;
    margin-bottom: 1;
}
#workspace-list .workspace-home-content,
#workspace-list .workspace-home-card Static { height: auto; }
#workspace-list .workspace-home-title { text-style: bold; color: $accent; }
#workspace-list .workspace-home-scope { color: $text-muted; }
#workspace-list .workspace-home-repo-count { margin-top: 1; text-style: bold; }
#workspace-list .workspace-home-open { margin-top: 1; color: $accent; }
#workspace-list .workspace-home-card.-highlight {
    border: round $accent;
    background: $boost;
}

#workspace-create-screen,
#workspace-detail-screen {
    layout: vertical;
    width: 100%;
}

#workspace-create-body,
#workspace-detail-body {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#workspace-heading {
    height: auto;
    padding: 0 1;
}
#workspace-identity { height: auto; color: $text-muted; padding: 0 1; }

#workspace-scope {
    height: auto;
    color: $text-muted;
    padding: 0 1 1 1;
}

#workspace-repositories {
    height: auto;
}

.workspace-repository-item {
    height: auto;
    border: round $primary;
    background: $surface;
    color: $text;
    padding: 1 2;
    margin-bottom: 1;
}

#workspace-modules, #workspace-modules > ContentSwitcher,
#workspace-modules TabPane {
    width: 100%;
    height: 1fr;
}

#workspace-modules TabPane {
    padding: 1;
    background: $surface;
}

.workspace-module-body {
    width: 100%;
    height: 1fr;
}
.workspace-module-title {
    height: auto;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}
.workspace-module-description {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.workspace-defect-filter-card {
    width: 100%;
    height: auto;
    border: round $primary;
    background: $boost;
    padding: 0 4 0 1;
    margin-bottom: 1;
}

.workspace-defect-filter-label {
    width: 8;
    height: 3;
    color: $text-muted;
    content-align: left middle;
}

#workspace-defect-assignee {
    width: 1fr;
    margin: 0;
}

.workspace-defect-filter-toolbar {
    width: 100%;
    height: 3;
}

.workspace-defect-actions {
    height: 3;
}

#workspace-detail-body .workspace-defect-filter-toolbar Button {
    height: 3;
    margin: 0 0 0 1;
}

#workspace-defect-status-filter-button {
    width: 14;
}
#workspace-reload-defect-options { width: 8; }
#workspace-query-defects { width: 16; }

#workspace-defect-status {
    width: 1fr;
    height: 2;
    color: $text-muted;
    content-align: right middle;
    padding: 0 1;
}

.workspace-defect-results-header {
    height: 2;
    margin: 0 1;
}

.workspace-defect-results-heading {
    width: auto;
    height: 2;
    text-style: bold;
    color: $accent;
    content-align: left middle;
}

#workspace-defect-results {
    height: auto;
}

.workspace-defect-empty {
    height: 5;
    color: $text-muted;
    border: round $panel;
    background: $surface;
    content-align: center middle;
    padding: 0 2;
    margin-bottom: 1;
}

.workspace-defect-card {
    height: auto;
    min-height: 7;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    margin-bottom: 1;
}

.workspace-defect-info {
    width: 1fr;
    height: auto;
}

.workspace-defect-actions {
    width: 31;
    min-width: 31;
    align: right middle;
    margin-left: 2;
}

.workspace-defect-actions Button {
    width: 15;
    margin-left: 1;
}

.workspace-defect-card.high {
    border: round $warning;
}

.workspace-defect-card .workspace-defect-title {
    height: auto;
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.workspace-defect-card .workspace-defect-meta {
    height: auto;
    color: $text-muted;
}

.workspace-defect-transition {
    height: auto;
    border: round $primary;
    padding: 1 2;
    color: $text-muted;
}

.workspace-requirement-filter-card {
    width: 100%;
    height: auto;
    border: round $primary;
    background: $boost;
    padding: 0 2 0 1;
    margin-bottom: 1;
}

.workspace-requirement-filter-row {
    width: 100%;
    height: 3;
}

.workspace-requirement-filter-label {
    width: 10;
    height: 3;
    color: $text-muted;
    content-align: left middle;
}

.workspace-requirement-filter-row Input {
    width: 1fr;
    margin: 0 1 0 0;
}

.workspace-requirement-filter-row Select {
    width: 1fr;
    margin: 0 1 0 0;
}

#workspace-requirement-status-filter-button {
    width: 1fr;
    height: 3;
    margin: 0 1 0 0;
}

#workspace-query-requirements {
    width: 16;
    height: 3;
    margin: 0;
}

.workspace-requirement-results-header {
    height: 2;
    margin: 0 1;
}

.workspace-requirement-results-heading {
    width: auto;
    height: 2;
    text-style: bold;
    color: $accent;
    content-align: left middle;
}

#workspace-requirement-status {
    width: 1fr;
    height: 2;
    color: $text-muted;
    content-align: right middle;
    padding: 0 1;
}

#workspace-requirement-results {
    height: auto;
}

.workspace-requirement-empty {
    height: 5;
    color: $text-muted;
    border: round $panel;
    background: $surface;
    content-align: center middle;
    padding: 0 2;
    margin-bottom: 1;
}

.workspace-requirement-card {
    width: 100%;
    height: auto;
    min-height: 7;
    border: round $primary;
    background: $surface;
    padding: 1 2;
    margin-bottom: 1;
}

.workspace-requirement-info {
    width: 1fr;
    height: auto;
}

.workspace-requirement-title {
    height: auto;
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.workspace-requirement-meta {
    height: auto;
    color: $text-muted;
}

.workspace-requirement-actions {
    width: 18;
    min-width: 18;
    height: 3;
    align: right middle;
    margin-left: 1;
}

.workspace-requirement-actions Button {
    width: 17;
    height: 3;
    margin: 0;
}

.workspace-requirement-transition {
    height: auto;
    border: round $primary;
    padding: 1 2;
    color: $text-muted;
}

DefectStatusFilterScreen {
    align: center middle;
    background: $background 70%;
}

#defect-status-filter-dialog {
    width: 72;
    max-width: 90%;
    height: 70%;
    min-height: 16;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#defect-status-filter-dialog .modal-title {
    height: auto;
    text-style: bold;
    color: $accent;
}

#defect-status-filter-dialog .modal-description {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#defect-status-filter-list {
    height: 1fr;
}

#defect-status-filter-dialog .modal-actions {
    height: 3;
    align: right middle;
}

#defect-status-filter-dialog .modal-actions Button {
    width: 16;
    margin-left: 1;
}

#workspace-task-board { width: 100%; height: 1fr; }
#task-board-header { width: 100%; height: auto; }
#task-board-heading { width: 1fr; height: auto; }
#task-board-toolbar {
    width: auto;
    height: 3;
    align: right middle;
}
#task-board-toolbar Button { min-width: 12; margin-left: 1; }
#workspace-task-status {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}
#task-board-columns { width: 100%; height: 1fr; }
#workspace-detail-body.one #task-board-columns,
#workspace-detail-body.two #task-board-columns { layout: vertical; }
#workspace-detail-body.one .task-board-column,
#workspace-detail-body.two .task-board-column {
    width: 100%;
    height: 1fr;
    margin: 0 0 1 0;
}
#workspace-detail-body.one #task-board-header { layout: vertical; }
#workspace-detail-body.one #task-board-toolbar { width: 100%; }
.task-board-column {
    width: 1fr;
    height: 100%;
    border: round $panel;
    background: $boost;
    margin-right: 1;
    padding: 0 1;
}
.task-board-column:last-of-type { margin-right: 0; }
.task-board-column-title {
    width: 1fr;
    height: auto;
    text-style: bold;
    color: $accent;
    padding-top: 1;
}
.task-board-column-count {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}
.task-board-list { width: 100%; height: 1fr; background: transparent; }
.task-board-card {
    width: 100%;
    height: auto;
    border: round $primary;
    background: $surface;
    margin-bottom: 1;
    padding: 0 1;
}
.task-board-card Static, .task-card-content { height: auto; }
.task-card-title { text-style: bold; color: $text; }
.task-card-badge { color: $accent; }
.task-board-card.priority-high { border: round $warning; }
.task-board-card.priority-high .task-card-badge { color: $warning; }
.task-board-card.failed { border: round $error; }
.task-board-card.failed .task-card-description { color: $error; }
.task-board-card.attention { border: round $warning; }
.task-board-card.complete .task-card-description { color: $success; }
.task-card-description, .task-card-meta { color: $text-muted; }
.task-card-description { margin-top: 1; }
.task-card-open { color: $accent; margin-top: 1; }
.task-board-card.-highlight {
    border: round $accent;
    background: $boost;
}
#workspace-detail-notice { height: auto; }
#workspace-detail-footer {
    width: 100%;
    height: 3;
    padding: 0 2;
    align-horizontal: right;
}
#workspace-detail-footer Button { margin-left: 1; }

#workspace-create-body Input,
#workspace-create-body Select,
#workspace-create-body Button,
#workspace-detail-body Button {
    margin-bottom: 1;
}

.candidate-actions {
    height: 3;
    margin-bottom: 1;
}

.candidate-actions Button {
    width: 1fr;
}

#run-list-pane {
    width: 34;
    height: 100%;
    border-right: solid $primary;
}

#run-detail {
    width: 1fr;
    height: 100%;
}

RunDetailPane {
    height: 100%;
}

RunDetailPane TabbedContent,
RunDetailPane TabPane,
RunDetailPane .detail-scroll {
    width: 100%;
    height: 1fr;
}

RunDetailPane .detail-scroll Static {
    width: 100%;
    height: auto;
}

#ai-activity-scroll {
    background: $surface;
}

#ai-activity-content {
    padding: 1 2;
}

#review-status {
    height: auto;
    padding: 1;
    margin: 0 1;
    border: round $primary;
    background: $surface;
}

#review-scroll {
    background: $surface;
}

#review-content {
    padding: 1;
}

#overview-content, #repositories-content, #tests-content, #publication-content, #history-content {
    padding: 1;
}

.pane-title {
    text-style: bold;
    padding: 0 1;
}

#settings-page {
    display: none;
    width: 1fr;
    height: 100%;
    padding: 1;
}

#configuration-tabs, #configuration-tabs > ContentSwitcher {
    height: 1fr;
}

#configuration-tabs TabPane {
    height: 1fr;
    padding: 1;
}

.configuration-description {
    height: auto;
    margin-bottom: 1;
}

#settings {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#dashboard.two #navigation,
#dashboard.one #navigation {
    display: none;
}

#dashboard.two #run-list-pane {
    width: 32;
}

#dashboard.one #run-list-pane {
    width: 1fr;
    border-right: none;
}

#dashboard.one #task-detail-column {
    display: none;
}

#run-detail-screen #run-detail {
    display: block;
    width: 100%;
    height: 1fr;
}
